# --- API ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Секрет для подписи JWT (в проде — обязательно заменить, минимум 32 символа)
JWT_SECRET=dev-secret-key-change-me-in-production-0123456789
JWT_TTL=30d
SESSION_COOKIE=teenwork_session

# Разрешённые источники для CORS (через запятую)
CORS_ORIGIN=http://localhost:3000

# Код подтверждения. В dev — фиксированный, в проде генерируется случайно.
OTP_FIXED_CODE=111111
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
EXPOSE_OTP=true

LOG_LEVEL=info

# --- База данных ---
# Путь относительно корня репозитория
DB_PATH=data/teenwork.db

# --- Web ---
# Порт Next.js
WEB_PORT=3000
# Адрес API для обращений из браузера
NEXT_PUBLIC_API_URL=http://localhost:4000
