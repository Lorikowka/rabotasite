# Конфигурация веба. Скопируйте в apps/web/.env.local и правьте под себя.
# Все значения ниже — дефолты, с которыми приложение работает из коробки.

# Внутренний адрес API: по нему Next ходит сам и проксирует запросы браузера
# (same-origin /api/...). Меняйте, только если API на другой машине.
# API_INTERNAL_URL=http://127.0.0.1:4000

# Публичный адрес API для браузера. По умолчанию пусто — запросы идут
# через прокси Next, поэтому сайт работает и с телефона в локальной сети.
# NEXT_PUBLIC_API_URL=
