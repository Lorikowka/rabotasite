# Конфигурация API. Скопируйте в apps/api/.env и правьте под себя.
# Все значения ниже — дефолты, с которыми приложение работает из коробки.

# Порт и интерфейс. 0.0.0.0 — чтобы API было доступно из локальной сети.
PORT=4000
HOST=0.0.0.0

# Путь к базе SQLite (по умолчанию data/teenwork.db в корне монорепо).
# DB_PATH=data/teenwork.db

# Секрет подписи сессии. ОБЯЗАТЕЛЬНО замените в production.
# JWT_SECRET=change-me-to-a-long-random-string

# Время жизни сессии и имя httpOnly-куки.
# JWT_TTL=30d
# SESSION_COOKIE=teenwork_session

# Разрешённые origin для CORS (через запятую).
# В dev дополнительно разрешаются origin из локальной сети (10.x, 192.168.x, 172.16-31.x).
# CORS_ORIGIN=http://localhost:3000
# CORS_ALLOW_PRIVATE=true

# Доверенные прокси (через запятую) — по ним определяется IP клиента.
# Не ставьте true: X-Forwarded-For тогда можно подделать.
# TRUST_PROXY=127.0.0.1,::1

# Код подтверждения. В dev фиксированный, в production — случайный.
# OTP_FIXED_CODE=111111
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# EXPOSE_OTP=true

# LOG_LEVEL=info
